@{
}

@model Movie

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card shadow-lg p-4 text-center">
        <h2 class="text-danger">Confirm Deletion</h2>
        <h4 class="mt-3">@Model.MovieTitle (<span class="text-muted">@Model.MovieYear</span>)</h4>

        <p class="mt-3">Are you sure you want to delete this movie? This action cannot be undone.</p>

        <form method="post" class="mt-4 d-flex justify-content-center gap-4">

            <input type="hidden" asp-for="MovieID" />

            <button type="submit" class="btn btn-danger btn-lg px-5">Delete</button>
            <a class="btn btn-secondary btn-lg px-5" asp-controller="Home" asp-action="ViewMovies">Cancel</a>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>